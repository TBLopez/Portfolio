---
import Icon from './Icon.astro';
---

<header
  class="bg-surface/80 backdrop-blur-md text-primary-container border-b border-outline-variant/30 shadow-[0_0_15px_rgba(0,255,65,0.08)] flex justify-between items-center w-full px-3 md:px-4 h-12 md:h-10 sticky top-0 z-40 shrink-0"
>
  <div class="flex items-center gap-2 md:gap-3 min-w-0">
    <button
      id="sidebar-toggle"
      type="button"
      class="md:hidden p-2.5 md:p-1 -ml-1 hover-lift rounded-sm"
      aria-label="Toggle navigation sidebar"
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <Icon name="menu" size={20} />
    </button>
    <div class="text-primary-container font-bold flex items-center gap-2 truncate font-ui">
      <span aria-hidden="true" class="glow-text">&gt;_</span>
      <span class="truncate tracking-wide">TONY@FIREFLY:~</span>
    </div>
  </div>

  <nav aria-label="Primary" class="flex items-center gap-2 md:gap-4 shrink-0">
    <ul class="hidden md:flex gap-2 m-0 p-0 list-none">
      <li>
        <!-- Was a dead button: now it runs the real command. -->
        <button
          type="button"
          data-command="ls"
          class="text-primary-container brightness-125 hover:bg-primary-container/10 hover:text-primary-container px-3 py-1 rounded-sm transition-all duration-200 font-ui text-xs tracking-wider hover-lift"
        >
          Directory
        </button>
      </li>
      <li>
        <button
          type="button"
          data-command="tail"
          class="text-primary-container/80 hover:bg-primary-container/10 hover:text-primary-container px-3 py-1 rounded-sm transition-all duration-200 font-ui text-xs tracking-wider hover-lift"
        >
          Log Feed
        </button>
      </li>
    </ul>
    <button
      id="sfx-toggle"
      type="button"
      class="text-[11px] md:text-[10px] text-primary-container/80 hover:text-primary-container px-2 py-2 md:py-0 transition-colors"
      aria-pressed="true"
      aria-label="Toggle sound effects"
    >
      [SFX:ON]
    </button>
    <div class="hidden sm:flex gap-1" role="group" aria-label="Window controls">
      <button
        type="button"
        data-command="tail"
        class="p-1.5 text-primary-container/70 hover:text-primary-container hover:bg-primary-container/10 rounded-sm transition-colors"
        aria-label="Minimize — toggle the live log feed panel"
        title="Minimize — toggle log feed"
      >
        <Icon name="minimize" size={16} />
      </button>
      <button
        type="button"
        data-action="fullscreen"
        class="p-1.5 text-primary-container/70 hover:text-primary-container hover:bg-primary-container/10 rounded-sm transition-colors"
        aria-label="Maximize — toggle fullscreen"
        title="Maximize — fullscreen"
      >
        <Icon name="maximize" size={16} />
      </button>
      <button
        type="button"
        data-command="clear"
        class="p-1.5 text-primary-container/70 hover:text-error hover:bg-primary-container/10 rounded-sm transition-colors"
        aria-label="Close — clear the terminal output"
        title="Close — clear terminal"
      >
        <Icon name="close" size={16} />
      </button>
    </div>
  </nav>
</header>
