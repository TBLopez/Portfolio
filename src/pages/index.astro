---
import Layout from '../layouts/Layout.astro';
import TerminalHeader from '../components/TerminalHeader.astro';
import TerminalSidebar from '../components/TerminalSidebar.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import WelcomeBanner from '../components/WelcomeBanner.astro';
import { execSync } from 'node:child_process';
import { Client } from '@notionhq/client';
import type { ProjectEntry } from '../scripts/terminal';

// Notion SDK v5 renamed `databases.query` to `dataSources.query`.
// Accept either env var name so existing deployments keep working.
const notionDataSourceId =
  import.meta.env.NOTION_DATA_SOURCE_ID || import.meta.env.NOTION_DATABASE_ID;
const notionConnected = !!(import.meta.env.NOTION_API_KEY && notionDataSourceId);

let notionProjects: ProjectEntry[] = [];

if (notionConnected) {
  try {
    const notion = new Client({ auth: import.meta.env.NOTION_API_KEY });
    const response = await notion.dataSources.query({
      data_source_id: notionDataSourceId,
    });
    notionProjects = response.results.map((page: any) => {
      const nameProp = Object.values(page.properties).find(
        (p: any) => p.type === 'title',
      ) as any;
      const descProp = Object.values(page.properties).find(
        (p: any) => p.type === 'rich_text',
      ) as any;
      const urlProp = Object.values(page.properties).find(
        (p: any) => p.type === 'url',
      ) as any;
      const fileProp = Object.values(page.properties).find(
        (p: any) => p.type === 'files',
      ) as any;

      let finalUrl = '#';
      if (fileProp?.files?.length > 0) {
        const f = fileProp.files[0];
        finalUrl = f.file ? f.file.url : f.external ? f.external.url : '#';
      } else if (urlProp?.url) {
        finalUrl = urlProp.url;
      }

      return {
        id: page.id,
        title: nameProp?.title[0]?.plain_text || 'Untitled_Log',
        description: descProp?.rich_text[0]?.plain_text || 'No intel available.',
        url: finalUrl,
      };
    });
  } catch (error) {
    console.error('Notion Connection Error:', error);
  }
}

// Public GitHub repos, pulled at build time so the directory stays current
// without a CMS. Unauthenticated: 60 req/hour per IP is plenty for a build,
// and private repos simply never appear.
const GITHUB_USER = 'TBLopez';
// Anonymous requests are capped at 60/hour per IP, which a few rebuilds can
// burn through. Set GITHUB_TOKEN to lift that to 5,000/hour; the token is only
// ever used as a request header and never reaches the page.
const githubToken = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
let repoProjects: ProjectEntry[] = [];
try {
  const response = await fetch(
    `https://api.github.com/users/${GITHUB_USER}/repos?per_page=100&sort=pushed&direction=desc`,
    {
      headers: {
        accept: 'application/vnd.github+json',
        'user-agent': 'tonykl-portfolio-build',
        ...(githubToken ? { authorization: `Bearer ${githubToken}` } : {}),
      },
      signal: AbortSignal.timeout(7000),
    },
  );
  if (!response.ok) {
    // Never fail the build over this, but do say so out loud: quietly shipping
    // an empty directory is worse than a loud warning.
    console.warn(
      `GitHub repo lookup returned ${response.status} — directory will list local archives only.`,
    );
  }
  if (response.ok) {
    const repos = (await response.json()) as any[];
    repoProjects = repos
      .filter((repo) => repo && !repo.fork && !repo.archived && repo.name)
      .map((repo) => {
        // Prefer a live homepage, unless it is this site (avoids framing
        // ourselves) — then link to the source.
        const homepage: string | null = repo.homepage || null;
        const url =
          homepage && !/tonykl\.com/i.test(homepage) ? homepage : repo.html_url;
        const pushed = String(repo.pushed_at ?? '').slice(0, 10);
        return {
          id: String(repo.id),
          title: repo.name,
          description: repo.description
            ? `${repo.description} — pushed ${pushed}`
            : `Public repository, last pushed ${pushed}`,
          url,
          ext: '.url',
          tag: (repo.language as string) || 'CODE',
        };
      });
  }
} catch (error) {
  console.warn('GitHub repo lookup failed, continuing without:', error);
}

// Build-time fallback stamp. The client replaces it with the visitor's actual
// previous session (see initTerminal) — a static site can't know that at build.
const builtAt = new Date().toISOString();
const lastLogin = new Date(builtAt).toUTCString().replace('GMT', 'UTC').toUpperCase();

// Short commit stamp for `status`. Builds happen locally, so git is available;
// fall back to 'dev' when it isn't (tarball, CI without checkout).
let buildSha = 'dev';
try {
  buildSha = execSync('git rev-parse --short HEAD', { encoding: 'utf8' }).trim();
} catch {
  /* ignore */
}
---

<Layout>
  <TerminalHeader />

  <div class="flex flex-col md:flex-row flex-1 overflow-hidden relative min-h-0">
    <TerminalSidebar notionConnected={notionConnected} />

    <main
      id="terminal-output"
      class="flex-1 min-h-0 overflow-y-auto p-4 md:p-6 flex flex-col gap-4 font-body relative z-30"
    >
      <WelcomeBanner lastLogin={lastLogin} />

      <div
        id="history-container"
        role="log"
        aria-live="polite"
        aria-atomic="false"
        aria-label="Terminal output"
        class="space-y-4"
      >
      </div>
    </main>

    <aside
      id="log-pane"
      aria-label="Live system log feed"
      class="w-full md:w-[260px] lg:w-[320px] max-h-[35vh] md:max-h-none md:shrink-0"
      hidden
    >
      <div class="log-header">
        <span>/var/log/firefly.log</span>
        <span aria-hidden="true">●●●</span>
      </div>
      <div id="log-stream" class="log-stream"></div>
    </aside>
  </div>

  <TerminalFooter />
</Layout>

<script>
  import { initTerminal } from '../scripts/terminal';
  const root = document.getElementById('cmd-input');
  if (root) {
    const dataEl = document.getElementById('terminal-data');
    const data = dataEl?.textContent
      ? JSON.parse(dataEl.textContent)
      : { notionProjects: [], notionConnected: false };
    initTerminal(data);
  }
</script>

<script
  id="terminal-data"
  type="application/json"
  is:inline
  set:html={JSON.stringify({
    notionProjects: [...repoProjects, ...notionProjects],
    notionConnected,
    builtAt,
    buildSha,
  })}
/>
