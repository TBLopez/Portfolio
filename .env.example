# Notion CMS credentials (optional — site works without these in local mode)
# NOTION_API_KEY=ntn_...
# NOTION_DATA_SOURCE_ID=...
# NOTION_DATABASE_ID=...

# Optional. GitHub repo listing in the directory is anonymous by default
# (60 requests/hour per IP). Set this to raise the limit — a read-only,
# public-repo-scope token is plenty, and it is never sent to the browser.
# GITHUB_TOKEN=ghp_...
